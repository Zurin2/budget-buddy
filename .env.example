# Budget Buddy environment — copy to `.env.local` and fill in.
# Get keys at https://supabase.com/dashboard (Project Settings → API)
# and https://aistudio.google.com/apikey (create a NEW key for this app).

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
GEMINI_API_KEY=your-gemini-api-key
# Optional: defaults to gemini-3.5-flash-lite
GEMINI_MODEL=
